# Environment Configuration Example
# Copy to .env for local runtime settings. NEVER commit production secrets to Git!

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Node Environment ('development' or 'production')
NODE_ENV=development

# Database Storage Path (defaults to ./data/tickets.db)
DB_PATH=./data/tickets.db

# Authentication JWT Secret (HS256) - Minimum 32 characters
# Required in production. Do NOT share with TICKET_SECRET!
JWT_SECRET=replace-with-at-least-32-char-random-jwt-secret-key-here

# QR Ticket Verification Token Secret (HMAC-SHA256)
# Required in production. Must be strictly different from JWT_SECRET!
TICKET_SECRET=replace-with-at-least-32-char-random-ticket-secret-key-here
